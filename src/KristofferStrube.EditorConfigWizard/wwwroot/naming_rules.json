    {
        "Id": "naming_private_fields",
        "Title": "Private field naming style",
        "Description": "Choose the naming style for private fields.",
        "SymbolKinds": "field",
        "Accessibilities": "private",
        "Options": [
            {
                "Name": "_camelCase",
                "NamingStyle": {
                    "Capitalization": "camel_case",
                    "RequiredPrefix": "_"
                },
                "Examples": {
                    "Correct": "_firstName, _count, _isValid",
                    "Incorrect": "firstName, _FirstName, first_name"
                }
            },
            {
                "Name": "camelCase",
                "NamingStyle": {
                    "Capitalization": "camel_case"
                },
                "Examples": {
                    "Correct": "firstName, count, isValid",
                    "Incorrect": "_firstName, FirstName, first_name"
                }
            },
            {
                "Name": "PascalCase",
                "NamingStyle": {
                    "Capitalization": "pascal_case"
                },
                "Examples": {
                    "Correct": "FirstName, Count, IsValid",
                    "Incorrect": "_firstName, firstName, first_name"
                }
            }
        ],
        "DefaultOption": "_camelCase",
        "DefaultSeverity": "warning"
    },
    {
