[
    {
        "Id": "naming_interfaces",
        "Title": "Interfaces must begin with 'I'",
        "Description": "Interfaces should be prefixed with 'I' followed by PascalCase.",
        "SymbolKinds": "interface",
        "Accessibilities": "*",
        "NamingStyle": {
            "Capitalization": "pascal_case",
            "RequiredPrefix": "I"
        },
        "DefaultSeverity": "warning",
        "Examples": {
            "Correct": "IDisposable, IEnumerable, ILogger",
            "Incorrect": "Disposable, iLogger, Interface1"
        }
    },
    {
